\outl0\strokewidth0 \strokec2 Executive KPI Summary\
\
SELECT\
    COUNT(*) AS total_opportunities,\
    COUNT(CASE WHEN deal_stage = 'Won' THEN 1 END) AS won_deals,\
    ROUND(\
        COUNT(CASE WHEN deal_stage = 'Won' THEN 1 END)::NUMERIC\
        /\
        NULLIF(\
            COUNT(CASE WHEN deal_stage IN ('Won', 'Lost') THEN 1 END),\
            0\
        ),\
        4\
    ) AS win_rate,\
    SUM(\
        CASE WHEN deal_stage = 'Won' THEN close_value ELSE 0 END\
    ) AS total_won_revenue,\
    ROUND(\
        AVG(\
            CASE WHEN deal_stage = 'Won' THEN close_value END\
        ),\
        2\
    ) AS avg_won_deal_size\
FROM fact_opportunity;}